#endif (!RERAM)

#metal3->metal2
 defaultoverlap     allm3 metal3 allm2 metal2 88.540
 defaultsideoverlap allm3 metal3 allm2 metal2 61.869
 defaultsideoverlap allm2 metal2 allm3 metal3 39.946

#ifdef METAL5
#metal4
