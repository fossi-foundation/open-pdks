 and POLY
 and diffresarea
 and DIFF
 and-not NSDM
 and-not HVTP

 layer scpfethvt STDCELL
 and POLY
 and diffresarea
 and DIFF
 and-not NSDM
 and HVTP

# End of resistor area hack

 templayer xpolyterm RPM,URPM
 and POLY
 and-not POLYRES
 # add back the 0.08um contact surround in the direction of the resistor
 grow 80
 and POLY

