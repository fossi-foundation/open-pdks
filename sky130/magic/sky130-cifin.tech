 and-not PSDM
 and-not NSDM
 and-not POLY
 and HVI,hvcheck
 and mvnsdexpand

# The following recipes deal with DIFFRES layers expanded over large areas
# outside the resistor.  Find areas which may have been accidentally
# captured as a resistor which were supposed to be transistors.

 templayer diffresarea DIFFRES
 and-not HVI,hvcheck
 grow 3000

 layer pfet DIFF
 and diffresarea
 and POLY
 and-not NSDM
 and-not STDCELL
 and-not HVI

 layer mvpfet DIFF
 and diffresarea
 and POLY
 and-not NSDM
 and-not STDCELL
 and HVI

