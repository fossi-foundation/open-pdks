 defaultsideoverlap allm2 metal2 allm1 metal1 49.021
 defaultsideoverlap allm1 metal1 allm2 metal2 32.918

#ifdef METALS3 || METALS4 || METALS5 || METALS6
#metal3
 defaultsidewall    allm3 metal3  54.507 0.188
 defaultareacap     allm3 metal3  10.094
 defaultperimeter   allm3 metal3  30.707
